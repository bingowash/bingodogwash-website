{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "public-marketing-staging",
	"main": "_functions_NOT_FOR_STATIC_UPLOAD/api/marketing-staging.js",
	"compatibility_date": "2026-07-12",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"preview_urls": true,
	"workers_dev": true,
	"vars": {
		"ETSY_FEATURE_ENABLED": "false",
		"ETSY_SYNC_ENABLED": "false",
		"MARKETING_PUBLISHING_DISABLED": "true",
		"META_INSTAGRAM_USER_ID": "27879594505014566",
		"META_INSTAGRAM_USERNAME": "bingo_dogwash",
		"META_PAGE_ID": "1264938680034651"
	},
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"d1_databases": [
		{
			"binding": "GIFT_CARD_DB",
			"database_name": "bingo-marketing-staging",
			"migrations_dir": "./migrations"
		}
	]
}
