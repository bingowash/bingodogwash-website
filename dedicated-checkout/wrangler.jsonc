{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "bingo-checkout",
  "main": "src/worker.js",
  "workers_dev": true,
  "compatibility_date": "2026-07-06",
  "routes": [
    { "pattern": "*.bingodogwash.com/api/checkout*", "zone_name": "bingodogwash.com" },
    { "pattern": "*bingodogwash.com/api/checkout*", "zone_name": "bingodogwash.com" },
    { "pattern": "bingodogwash.com/api/checkout*", "zone_name": "bingodogwash.com" }
  ],
  "secrets": {
    "required": ["STRIPE_SECRET_KEY"]
  },
  "d1_databases": [
    {
      "binding": "AVASAM_CATALOGUE_DB",
      "database_name": "bingo-avasam-catalogue",
      "database_id": "2e509f9b-9f1b-47e5-9f44-81d5214b2e03",
      "migrations_dir": "../migrations/avasam-catalogue"
    }
  ]
}
