{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "bingo-checkout",
  "main": "src/worker.js",
  "workers_dev": true,
  "compatibility_date": "2026-07-06",
  "routes": [
    { "pattern": "*.bingodogwash.com/api/checkout*", "zone_name": "bingodogwash.com" },
    { "pattern": "*bingodogwash.com/api/checkout*", "zone_name": "bingodogwash.com" },
    { "pattern": "bingodogwash.com/api/checkout*", "zone_name": "bingodogwash.com" }
  ],
  "secrets": {
    "required": ["STRIPE_SECRET_KEY"]
  }
}
